# Без завершающего «/». Пути страниц в коде: /searchexcursions, /certificates, …
# Stage: https://stage.fstravel.com + путь  |  Prod: https://fstravel.com + путь
STAGE_BASE_URL=https://stage.fstravel.com
PROD_BASE_URL=https://fstravel.com

# Видео прогона Playwright: on | retain-on-failure | … (см. use.video в документации Playwright). По умолчанию не задавать — видео выключено.
# PW_VIDEO=on

# Вход в корзине (FstravelCommonAllPages: authInBag, authInBag2)
# CART_LOGIN_EMAIL=
# CART_LOGIN_PASSWORD=

# Test IT (testit-adapter-playwright), см. README и config.js
# Либо короткие имена, либо сразу TMS_* (подробнее — раздел «Test IT» в README)
# URL=https://ваш-testit.example
# USER_PRIVATE_TOKEN=
# PROJECT_ID=
# CONFIGURATION_ID=
# TEST_RUN_ID=
# TEST_RUN_NAME=
# ADAPTER_MODE=
# TMS_URL=  TMS_PRIVATE_TOKEN=  TMS_PROJECT_ID=  TMS_CONFIGURATION_ID=
# TMS_TEST_RUN_ID=  TMS_TEST_RUN_NAME=  TMS_ADAPTER_MODE=
